{
  "version": 2,
  "installCommand": "cd api && npm install && cd ../frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/v1/webhook/builderbot.js": {
      "includeFiles": "api/node_modules/{pdfjs-dist/legacy/build/**,@napi-rs/canvas*/**}"
    },
    "api/v1/warehouse-documents.js": {
      "includeFiles": "api/node_modules/{pdfjs-dist/legacy/build/**,@napi-rs/canvas*/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/siigo/import-purchases",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/v1/siigo/import-invoices",
      "schedule": "1-59/2 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/v1/products/:id", "destination": "/api/v1/products/[id]" },
    { "source": "/api/v1/inventory/product/:id", "destination": "/api/v1/inventory/product/[id]" },
    { "source": "/api/v1/inventory/lot/:lpn", "destination": "/api/v1/inventory/lot/[lpn]" },
    { "source": "/api/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
