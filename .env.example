# ─── SERVIDOR ────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── BASE DE DATOS MySQL ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wms_db
DB_USER=wms_user
DB_PASSWORD=your_password_here

# ─── AUTENTICACIÓN JWT ───────────────────────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=8h

# ─── INTEGRACIÓN SIIGO ───────────────────────────────────
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=your_siigo_email@company.com
SIIGO_ACCESS_KEY=your_siigo_access_key
SIIGO_PARTNER_ID=your_partner_id

# ─── INTEGRACIÓN SYSCAFÉ ─────────────────────────────────
# Token fijo sin vencimiento que SysCafé envía en Authorization: Bearer
SYSCAFE_API_TOKEN=your_syscafe_secret_token_here
# Tipo de documento SysCafé (FV2 = factura de venta, PE2 = pedido, etc.)
SYSCAFE_TIPO_DOC=FV2
# Porcentaje de IVA por defecto si el producto no lo tiene definido
SYSCAFE_IVA_PCT=19

# ─── FRONTEND ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── OPCIONALES ───────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@company.com
# SMTP_PASS=your_smtp_password
