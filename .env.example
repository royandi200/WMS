NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wms_db
DB_USER=wms_user
DB_PASSWORD=change_me
DB_SSL=false
# Offset used to interpret MySQL DATETIME values (America/Bogota).
DB_TIMEZONE=-05:00

# Docker MySQL bootstrap
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=wms_db
MYSQL_USER=wms_user
MYSQL_PASSWORD=change_me

# JWT auth
JWT_SECRET=change_me_access_secret_32_chars_min
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Browser/API origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WMS_PUBLIC_URL=https://your-wms.example.com
CRON_SECRET=change_me_cron_secret

# BuilderBot
BUILDERBOT_WEBHOOK_SECRET=change_me_webhook_secret
BUILDERBOT_KW=g0m@s
BUILDERBOT_API_TOKEN=change_me_builderbot_api_token
BUILDERBOT_BOT_ID=change_me_builderbot_bot_id
BUILDERBOT_ALLOWED_ORIGIN=https://app.builderbot.cloud
# Manager API key belongs in the operator/MCP environment, not in Vercel.
# BUILDERBOT_MANAGER_API_KEY=change_me_manager_key

# Operational safety switches
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_HTTP_MIGRATIONS=false
DEFAULT_PRODUCTION_BODEGA_ID=1
WMS_PRIMARY_WAREHOUSE_CODE=BG-PPAL

# Initial seed admin. Leave password unset in shared/prod environments.
SEED_ADMIN_EMAIL=admin@wms.local
SEED_ADMIN_PHONE=0000000000
SEED_ADMIN_PASSWORD=

# SIIGO
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=your_siigo_email@company.com
SIIGO_ACCESS_KEY=your_siigo_access_key
SIIGO_PARTNER_ID=your_partner_id
SIIGO_TEST_PREFIX=WMSQA-
SIIGO_TIMEZONE_OFFSET=-05:00
SIIGO_WMS_WAREHOUSE_CODE=your_siigo_warehouse_code
SIIGO_QUOTATION_REFERENCE_PREFIX=WMSQA-COT-
SIIGO_WEBHOOK_SECRET=change_me_siigo_webhook_secret
SIIGO_WEBHOOK_APPLICATION_ID=your_siigo_application_id
SIIGO_ALLOW_SHARED_SANDBOX_WEBHOOK_UPDATE=false
SIIGO_STAMP_SEND=false

# SysCafe
SYSCAFE_API_TOKEN=your_syscafe_secret_token_here
SYSCAFE_TIPO_DOC=FV2
SYSCAFE_IVA_PCT=19

# SMTP optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@company.com
# SMTP_PASS=your_smtp_password
# Workflow feature flags (risky/optional behavior is disabled by default)
ALLOW_PARTIAL_DISPATCH=false
ENABLE_BACKORDER_ALERTS=false
AUTO_RELEASE_STALE_RESERVATIONS=false
RESERVE_AVAILABLE_ON_SHORTAGE=true
REQUIRE_PURCHASE_ORDER_FOR_SIIGO_RECEIPT=true
ALLOW_SPLIT_PRODUCTION_LINE=false
ALLOW_DIRECT_DISPATCH_REQUEST=false
ALLOW_MANUAL_RECEPTION=false
DISABLE_OUTBOUND_NOTIFICATIONS=false
ENABLE_WORKFLOW_NOTIFICATIONS=false
